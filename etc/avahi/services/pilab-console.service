<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Reference copy. The installed file is generated by `pilabd mdns-service` with this device id. Advertises Trillium Base and Trillium Console on the LAN. -->
<service-group>
  <name replace-wildcards="yes">Trillium Base (%h)</name>
  <service>
    <type>_pilab._tcp</type>
    <port>8410</port>
    <txt-record>version=0.2.0</txt-record>
    <txt-record>api=/api/v1</txt-record>
    <txt-record>id=DEVICE_ID</txt-record>
    <txt-record>pairing=token</txt-record>
    <txt-record>product=Trillium Base</txt-record>
    <txt-record>console=Trillium Console</txt-record>
  </service>
  <service>
    <type>_trillium-base._tcp</type>
    <port>8410</port>
    <txt-record>version=0.2.0</txt-record>
    <txt-record>api=/api/v1</txt-record>
    <txt-record>id=DEVICE_ID</txt-record>
    <txt-record>pairing=token</txt-record>
    <txt-record>product=Trillium Base</txt-record>
    <txt-record>console=Trillium Console</txt-record>
  </service>
  <service>
    <type>_http._tcp</type>
    <port>8410</port>
    <txt-record>path=/</txt-record>
    <txt-record>version=0.2.0</txt-record>
    <txt-record>api=/api/v1</txt-record>
    <txt-record>id=DEVICE_ID</txt-record>
    <txt-record>pairing=token</txt-record>
    <txt-record>product=Trillium Base</txt-record>
    <txt-record>console=Trillium Console</txt-record>
  </service>
</service-group>
