# AirPlay 2 receiver for the audio user. Off by default; toggle with
# "pilab-airplay receiver on|off". Needs the nqptp.service system unit.
[Unit]
Description=AirPlay receiver (shairport-sync) into PipeWire
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
ExecStartPre=/bin/sh -c 'for i in $$(seq 40); do systemctl is-active --quiet nqptp.service && exit 0; sleep 0.25; done; echo "nqptp.service is not running"; exit 1'
ExecStart=/usr/local/bin/shairport-sync -c /etc/shairport-sync.conf
Restart=on-failure
RestartSec=3
Nice=-5

[Install]
WantedBy=default.target
