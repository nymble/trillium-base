[Unit]
Description=Local-only VNC for the desktop session (reach it over an SSH tunnel)
After=graphical-session.target
[Service]
Environment=WAYLAND_DISPLAY=wayland-0
ExecStartPre=/bin/sh -c "while [ ! -S $XDG_RUNTIME_DIR/wayland-0 ]; do sleep 1; done"
ExecStart=/usr/bin/wayvnc --gpu --config %h/.config/wayvnc/config
Restart=on-failure
RestartSec=3
[Install]
WantedBy=default.target
